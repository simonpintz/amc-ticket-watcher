# Copy this file to .env and fill in your values for local testing.
# In production (Railway/Fly.io/etc.) set these as the platform's env vars instead
# of using a .env file.

# --- What to watch ---
# The exact AMC showtimes page URL for the theatre + date you care about.
THEATRE_URL=https://www.amctheatres.com/movie-theatres/new-york-city/amc-lincoln-square-13/showtimes?date=2026-09-14

# These slugs/keys come from the page itself (see README "How detection works").
MOVIE_SLUG=the-odyssey-76238
THEATRE_SLUG=amc-lincoln-square-13
# Leave FORMAT_KEY blank (FORMAT_KEY=) to alert on ANY format for this movie,
# i.e. the instant it has any showtimes at all, regardless of format.
FORMAT_KEY=imax70mm

# Just used to make the SMS message readable.
MOVIE_DISPLAY_NAME=The Odyssey
FORMAT_DISPLAY_NAME=IMAX 70mm

# --- Polling behavior ---
# Kept conservative by default to reduce the odds of tripping AMC's bot-check
# under sustained polling. Only speed this up temporarily (e.g. 30-45s) for a
# short, deliberate window right around a known on-sale time.
POLL_INTERVAL_SECONDS=120
POLL_JITTER_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20

# Re-send the "it's live" text every 15 min (up to 6 times) in case you miss the first one.
RENOTIFY_INTERVAL_SECONDS=900
MAX_RENOTIFY=6

# If the watcher fails to reach AMC's site 15 times in a row, send one warning text
# (and at most once every 2 hours after that) so you know it's broken.
FAILURE_ALERT_THRESHOLD=15
FAILURE_ALERT_COOLDOWN_SECONDS=7200

STATE_FILE=state.json

# --- Notifications (Resend HTTPS API - free) ---
# Gmail SMTP does NOT work when deployed - Railway (and most PaaS hosts) block
# outbound SMTP entirely except on paid/Pro plans. Resend is a plain HTTPS API
# instead of a raw SMTP socket connection, so it isn't affected by that block.
# 1. Sign up free at https://resend.com (no credit card, no domain required).
# 2. Create an API key: https://resend.com/api-keys -> paste it below.
# 3. On the free/no-domain sandbox, you can ONLY send to the email address you
#    signed up to Resend with - that's fine, that's your own alert address.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=AMC Watcher <onboarding@resend.dev>

# Comma-separated list of destination addresses. Your Resend account email is
# required. You can also list a carrier email-to-SMS gateway address (e.g.
# NUMBER@txt.att.net) to try to also get a text - it'll just fail harmlessly
# on the free Resend sandbox (403, logged and skipped) since it's not your
# account address, unless/until you verify your own domain in Resend.
NOTIFY_EMAILS=you@gmail.com,6505551234@txt.att.net
