# Copy this file to .env and fill in your values for local testing.
# In production (Railway/Fly.io/etc.) set these as the platform's env vars instead
# of using a .env file.

# --- What to watch ---
# The exact AMC showtimes page URL for the theatre + date you care about.
THEATRE_URL=https://www.amctheatres.com/movie-theatres/new-york-city/amc-lincoln-square-13/showtimes?date=2026-09-14

# These slugs/keys come from the page itself (see README "How detection works").
MOVIE_SLUG=the-odyssey-76238
THEATRE_SLUG=amc-lincoln-square-13
FORMAT_KEY=imax70mm

# Just used to make the SMS message readable.
MOVIE_DISPLAY_NAME=The Odyssey
FORMAT_DISPLAY_NAME=IMAX 70mm

# --- Polling behavior ---
POLL_INTERVAL_SECONDS=45
POLL_JITTER_SECONDS=15
REQUEST_TIMEOUT_SECONDS=20

# Re-send the "it's live" text every 15 min (up to 6 times) in case you miss the first one.
RENOTIFY_INTERVAL_SECONDS=900
MAX_RENOTIFY=6

# If the watcher fails to reach AMC's site 15 times in a row, send one warning text
# (and at most once every 2 hours after that) so you know it's broken.
FAILURE_ALERT_THRESHOLD=15
FAILURE_ALERT_COOLDOWN_SECONDS=7200

STATE_FILE=state.json

# --- Notifications (Gmail SMTP - free) ---
# 1. Turn on 2-Step Verification on the Google account below (myaccount.google.com/security).
# 2. Create an App Password at myaccount.google.com/apppasswords (choose "Mail" / "Other").
# 3. Paste the 16-character app password here (NOT your real Gmail password).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Comma-separated list of destination addresses. Include your real email AND your
# phone's free carrier email-to-SMS gateway address to also get a text-like alert:
#   AT&T:      NUMBER@txt.att.net
#   Verizon:   NUMBER@vtext.com
#   T-Mobile:  NUMBER@tmomail.net
# (NUMBER = 10 digits, no dashes/country code, e.g. 6505551234@txt.att.net)
NOTIFY_EMAILS=you@gmail.com,6505551234@txt.att.net
